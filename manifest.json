{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "short_name": "Future Me",
  "description": "__MSG_extDescription__",
  "version": "1.3.2",
  "default_locale": "en",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Future Me",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "options_page": "options/options.html",
  "background": {
    "service_worker": "src/background.js"
  },
  "permissions": [
    "storage",
    "alarms",
    "notifications",
    "activeTab",
    "scripting"
  ],
  "optional_host_permissions": [
    "https://*/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://*.amazon.com.be/*",
        "https://*.amazon.nl/*",
        "https://*.amazon.de/*",
        "https://*.amazon.fr/*",
        "https://*.amazon.es/*",
        "https://*.amazon.it/*",
        "https://*.amazon.co.uk/*",
        "https://*.amazon.com/*",
        "https://*.bol.com/*",
        "https://*.coolblue.be/*",
        "https://*.coolblue.nl/*",
        "https://*.zalando.be/*",
        "https://*.zalando.nl/*",
        "https://*.zalando.de/*",
        "https://*.zalando.fr/*",
        "https://*.temu.com/*",
        "https://*.shein.com/*",
        "https://*.aliexpress.com/*",
        "https://*.ebay.be/*",
        "https://*.ebay.nl/*",
        "https://*.ebay.de/*",
        "https://*.ebay.com/*",
        "https://*.mediamarkt.be/*",
        "https://*.mediamarkt.nl/*",
        "https://*.vandenborre.be/*",
        "https://*.fnac.be/*",
        "https://*.decathlon.be/*",
        "https://*.ikea.com/*",
        "https://*.etsy.com/*"
      ],
      "js": [
        "vendor/qrcode.js",
        "src/shared.js",
        "src/transfer.js",
        "src/sites.js",
        "src/content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "brand/logo.svg",
        "fonts/*.woff2"
      ],
      "matches": [
        "https://*/*"
      ]
    }
  ]
}
